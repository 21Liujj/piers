# Normalise line endings so that the SHA256 fingerprints recorded for the
# experiment code stay valid across Windows / Linux checkouts.
* text=auto eol=lf

# The source snapshot under results/ is a byte-for-byte archive of the code
# that produced the paper numbers. Its SHA256 is checked against
# results/I1_densepass/source_fingerprints.json, so it MUST be stored
# verbatim - no line-ending conversion.
results/I1_densepass/source_snapshot/** -text
results/I1_densepass/source_snapshot.tar.gz -text

# The indoor protocol fingerprints the actual experimental script bytes,
# including their original line endings. Preserve those bytes in fresh clones.
scripts/piers/indoor_matched_*.py -text whitespace=cr-at-eol,-blank-at-eof
# Matplotlib SVGs are exported evidence, preserved verbatim like the PNGs.
results/indoor_matched20261112/figures/*.svg -text -diff

# Binary assets
*.pt binary
*.pth binary
*.npz binary
*.ckpt binary
*.png binary
*.jpg binary
*.zip binary
*.gz binary
*.tar binary
